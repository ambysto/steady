// Shared build settings for the Steady app (ADR-0010).
// Per-developer values (team ID, bundle ID suffix) go in Local.xcconfig, which is not tracked.

// Identity: "Ambysto Steady.app" and its menu name, as "Ambysto Steady.exe" on Windows; the Swift
// module keeps the short name.
PRODUCT_NAME = Ambysto Steady
PRODUCT_MODULE_NAME = Steady
STEADY_BUNDLE_ID_SUFFIX =
PRODUCT_BUNDLE_IDENTIFIER = com.ambysto.steady$(STEADY_BUNDLE_ID_SUFFIX)
MARKETING_VERSION = 0.8.1
// Each upload to App Store Connect needs a new build number: apple/scripts/release.sh sets the UTC
// time as year.monthday.hourminute, such as 2026.1005.1830 (apple/RELEASE.md).
CURRENT_PROJECT_VERSION = 1

// Platforms: iPhone, iPad and a native Mac app (no Mac Catalyst, no "Designed for iPad")
SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks

// Build
ALWAYS_SEARCH_USER_PATHS = NO

// Swift
SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Localization: every text comes from the catalogs generated from app/locales, so nothing is
// extracted from Swift source and Xcode does not generate symbols for the keys.
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = NO
STRING_CATALOG_GENERATE_SYMBOLS = NO

// App icon: Steady/AppIcon.icon (Icon Composer; light, dark and tinted appearances)
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Info.plist
GENERATE_INFOPLIST_FILE = YES
// CFBundleDisplayName and permission texts: Generated.xcconfig (from app/locales).
#include "Generated.xcconfig"
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
// Only the system's HTTPS (exempt): App Store Connect does not ask about export compliance.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// macOS: sandboxed, outgoing connections only
ENABLE_APP_SANDBOX[sdk=macosx*] = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS[sdk=macosx*] = YES
ENABLE_HARDENED_RUNTIME[sdk=macosx*] = YES

// Signing
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
