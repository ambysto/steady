    "ui.sheet.experimental.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ kann die Geschwindigkeit verringern oder Nebenwirkungen haben. Der ursprüngliche Wert wird gesichert, daher lässt sich die Optimierung jederzeit ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” can lower speed or have side effects. The original value is backed up, so you can turn it off at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» puede reducir la velocidad o tener efectos secundarios. El valor original se guarda en una copia de seguridad, así que puedes desactivarla en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » peut réduire le débit ou avoir des effets secondaires. La valeur d'origine est sauvegardée, vous pouvez le désactiver à tout moment."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” pode reduzir a velocidade ou ter efeitos colaterais. O valor original fica em backup, então você pode desativá-la a qualquer momento."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” có thể làm giảm tốc độ hoặc có tác dụng phụ. Giá trị gốc được sao lưu, bạn có thể tắt lại bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”可能降低速度或产生副作用。原始值已备份，你可以随时关闭它。"
          }
        }
      }
    },
    "ui.sheet.experimental.title" : {
