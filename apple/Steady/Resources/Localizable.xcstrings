    "ui.check.sheet.admin" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows fragt einmal nach Administratorrechten. Jede Änderung wird gesichert und kann auf der Seite „Optimieren“ wieder ausgeschaltet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows asks for administrator approval once. Every change is backed up and can be turned off on the Optimize page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows pide permiso de administrador una vez. Cada cambio se guarda en una copia de seguridad y se puede desactivar en la página Optimizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
