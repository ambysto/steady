    "diag.wifi7_mlo.advice_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Verbindungsabbrüchen oder einbrechendem Rx MLO am Router ausschalten (EXP-009)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the connection drops or Rx collapses, turn off MLO on the router (EXP-009)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la conexión se corta o Rx se desploma, desactiva MLO en el router (EXP-009)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la connexion coupe ou si le Rx s'effondre, désactivez le MLO sur le routeur (EXP-009)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が切れる、または Rx が急落する場合は、ルーターで MLO をオフにしてください（EXP-009）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결이 끊기거나 Rx가 급락하면 라우터에서 MLO를 끄십시오 (EXP-009)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a conexão cair ou o Rx despencar, desative o MLO no roteador (EXP-009)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu rớt mạng hoặc Rx sụp thì tắt MLO trên router (EXP-009)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果连接掉线或 Rx 骤降，请在路由器上关闭 MLO (EXP-009)。"
          }
        }
      }
    },
    "diag.wifi7_mlo.advice_warn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MLO/Wi‑Fi 7 am Router ausschalten oder eine mit Wi‑Fi 5/6 kompatible SSID verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off MLO/Wi‑Fi 7 on the router, or use an SSID compatible with Wi‑Fi 5/6."
          }
        },
        "es" : {
