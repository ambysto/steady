          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload limitado por este app a %1$@ Mbps e o upload chegou ao limite (%2$@ Mbps): se o seu plano ficou mais rápido, desative e ative o limite de novo para medir a linha"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload đang bị ứng dụng giới hạn ở %1$@ Mbps và đã chạm mức đó (%2$@ Mbps): nếu gói cước đã nhanh hơn, hãy tắt rồi bật lại giới hạn để đo đường truyền"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
