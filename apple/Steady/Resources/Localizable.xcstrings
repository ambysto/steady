    "diag.bufferbloat.shaped_at_limit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload von dieser App auf %1$@ Mbit/s begrenzt, und der Upload hat sie erreicht (%2$@ Mbit/s): Wenn Ihr Tarif schneller geworden ist, schalten Sie die Begrenzung aus und wieder ein, um die Leitung zu messen"
