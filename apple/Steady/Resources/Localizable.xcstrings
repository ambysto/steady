          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ một đích trả lời và đích đó có thể vốn đã rơi ping, nên đường truyền nhỏ hơn chưa được xác nhận"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
