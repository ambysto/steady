    "ui.history.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemessen wird nur, solange die App geöffnet ist; Lücken sind die Zeiten, in denen sie geschlossen war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measured only while the app is open; gaps are the times it was closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se mide mientras la app está abierta; los huecos son los momentos en que estaba cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesuré uniquement lorsque l'app est ouverte ; les trous correspondent aux moments où elle était fermée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを開いている間だけ測定します。空白はアプリが閉じていた時間です。"
