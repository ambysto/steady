    "diag.ping.advice_wan" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Router ist in Ordnung, der Fehler liegt also dahinter: TCP/DNS prüfen (siehe DNS-Prüfung) oder den Provider kontaktieren."
          }
        },
        "en" : {
