          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信号が非常に弱いため、主な原因は距離や障害物です。信号のチェックを参照してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신호가 매우 약하므로 주로 거리 또는 장애물 문제입니다. 신호 점검을 참조하십시오"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sinal está muito fraco, então é principalmente distância ou obstáculos; veja a verificação de sinal"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tín hiệu rất yếu nên đây chủ yếu là vấn đề khoảng cách/vật cản, xem kiểm tra tín hiệu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信号非常弱，主要是距离或障碍物所致；请参见信号检查"
          }
        }
      }
    },
    "diag.ping.advice_icmp_limited" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts zu beheben. Ping ins Internet ist in diesem Netzwerk nicht zuverlässig; die TCP/HTTP-Werte sind maßgeblich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing to fix. Ping to the Internet is not reliable on this network; go by the TCP/HTTP numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada que arreglar. El ping a Internet no es fiable en esta red; guíate por los valores de TCP/HTTP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à corriger. Le ping vers Internet n'est pas fiable sur ce réseau ; fiez-vous aux chiffres TCP/HTTP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対処は不要です。このネットワークではインターネットへの ping は信頼できません。TCP/HTTP の数値を基準にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조치할 필요가 없습니다. 이 네트워크에서는 인터넷 ping을 신뢰할 수 없으므로 TCP/HTTP 수치를 기준으로 판단하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada a corrigir. O ping para a Internet não é confiável nesta rede; baseie-se nos números de TCP/HTTP."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần xử lý. Số đo ping ra Internet không đáng tin trên mạng này; dựa vào số đo TCP/HTTP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需处理。此网络上到互联网的 ping 不可靠，请以 TCP/HTTP 数据为准。"
          }
        }
      }
    },
    "diag.ping.advice_router" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
