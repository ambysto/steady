        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt MLO/Wi‑Fi 7 trên router, hoặc dùng SSID tương thích Wi‑Fi 5/6."
          }
        },
        "zh-Hans" : {
