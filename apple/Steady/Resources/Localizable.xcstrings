    "diag.ping.wan_jitter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Router ist in Ordnung, aber die Latenz ins Internet schwankt (nur Ping, noch keine TCP/HTTP-Daten): ein Problem beim Provider/WAN oder ICMP wird nachrangig behandelt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The router is fine but latency to the Internet is unstable (ping only, no TCP/HTTP data yet): an ISP/WAN problem, or ICMP is deprioritized"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El router funciona bien pero la latencia hacia Internet es inestable (solo ping, aún sin datos TCP/HTTP): un problema del ISP/WAN, o ICMP tiene baja prioridad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le routeur fonctionne mais la latence vers Internet est instable (ping uniquement, pas encore de données TCP/HTTP) : problème côté FAI/WAN, ou ICMP traité en basse priorité"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O roteador está bem, mas a latência até a Internet está instável (apenas ping, ainda sem dados de TCP/HTTP): problema no provedor/WAN, ou o ICMP tem baixa prioridade"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Router tốt nhưng độ trễ ra Internet không ổn định (chỉ có số đo ping, chưa có TCP/HTTP): lỗi phía ISP/WAN, hoặc ICMP bị xếp ưu tiên thấp"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路由器正常，但到互联网的延迟不稳定（仅有 ping 数据，暂无 TCP/HTTP 数据）：ISP/WAN 问题，或 ICMP 被降低优先级"
          }
        }
      }
    },
