    "diag.bufferbloat.at_ceiling" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$@-Last stoppte an der eigenen Grenze des Tests (%2$@ Mbps): Die Leitung ist womöglich schneller, ihre Warteschlange hat sich dann nicht gefüllt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %1$@ load stopped at the test's own limit (%2$@ Mbps): the line may be faster, so its queue may not have filled"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga de %1$@ se detuvo en el límite propio de la prueba (%2$@ Mbps): la línea puede ser más rápida, así que su cola quizá no se llenó"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge (%1$@) s'est arrêtée à la limite propre du test (%2$@ Mbps) : la ligne est peut-être plus rapide, sa file d'attente ne s'est donc peut-être pas remplie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carga de %1$@ parou no limite do próprio teste (%2$@ Mbps): a linha pode ser mais rápida, então a fila dela pode não ter enchido"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải chiều %1$@ dừng ở giới hạn của chính phép đo (%2$@ Mbps): đường truyền có thể nhanh hơn, nên hàng đợi có thể chưa đầy"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@负载停在了测试自身的上限（%2$@ Mbps）：线路可能更快，因此其队列可能未被填满"
          }
        }
      }
    },
