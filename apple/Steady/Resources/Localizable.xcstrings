    "diag.interference.advice_24g" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf 5 GHz wechseln, wenn das Signal es zulässt, oder den am wenigsten belegten der Kanäle 1/6/11 wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move to 5 GHz if the signal allows, or switch to whichever of channels 1/6/11 is least crowded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa a 5 GHz si la señal lo permite, o cambia al canal 1, 6 u 11 que esté menos saturado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez en 5 GHz si le signal le permet, ou choisissez celui des canaux 1/6/11 qui est le moins encombré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信号が届くなら 5 GHz に移るか、チャンネル 1/6/11 のうち最も混雑していないものに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신호가 허용하면 5 GHz로 옮기거나, 채널 1/6/11 중 가장 덜 붐비는 채널로 변경하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mude para 5 GHz se o sinal permitir, ou use o canal menos congestionado entre 1, 6 e 11."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển sang 5GHz nếu tín hiệu cho phép, hoặc đổi sang kênh 1/6/11 ít mạng nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果信号允许，请改用 5 GHz；或在信道 1/6/11 中选择最不拥挤的一个。"
          }
        }
      }
    },
    "diag.interference.advice_5g" : {
