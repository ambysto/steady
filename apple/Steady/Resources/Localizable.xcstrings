    "ui.report.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist der gesamte Inhalt des Berichts. Es wird nichts gesendet, außer du sendest es selbst. Er enthält keine Adressen, Netzwerknamen oder persönlichen Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is everything the report contains. Nothing is sent unless you send it yourself. It has no addresses, network names or personal data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es todo lo que contiene el informe. No se envía nada salvo que lo envíes tú. No incluye direcciones, nombres de red ni datos personales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici tout le contenu du rapport. Rien n'est envoyé si vous ne l'envoyez pas vous‑même. Il ne contient ni adresses, ni noms de réseau, ni données personnelles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é tudo o que o relatório contém. Nada é enviado a menos que você mesmo envie. Ele não tem endereços, nomes de rede nem dados pessoais."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là toàn bộ nội dung báo cáo. Không có gì được gửi đi trừ khi bạn tự gửi. Báo cáo không chứa địa chỉ, tên mạng hay dữ liệu cá nhân."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这就是报告的全部内容。除非你自己发送，否则不会发送任何内容。报告不含地址、网络名称或个人数据。"
          }
        }
      }
    },
