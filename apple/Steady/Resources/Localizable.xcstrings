    "diag.ping.advice_wan" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Router ist in Ordnung, der Fehler liegt also dahinter: TCP/DNS prüfen (siehe DNS-Prüfung) oder den Provider kontaktieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The router is fine, so the fault is beyond it: check TCP/DNS (see the DNS check) or contact your ISP."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El router funciona bien, así que el fallo está más allá: revisa TCP/DNS (consulta la comprobación de DNS) o contacta con tu ISP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le routeur fonctionne, la panne est donc au-delà : vérifiez TCP/DNS (voir la vérification DNS) ou contactez votre FAI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルーターは正常なので、原因はその先にあります。TCP/DNS（DNS チェックを参照）を確認するか、プロバイダーに連絡してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라우터는 정상이므로 그 너머에 문제가 있습니다: TCP/DNS를 확인하거나(DNS 점검 참조) 통신사에 문의하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O roteador está bem, então a falha está além dele: verifique o TCP/DNS (veja a verificação de DNS) ou fale com seu provedor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Router ổn nên lỗi nằm sau router: kiểm tra bằng TCP/DNS (xem kiểm tra DNS) hoặc liên hệ nhà mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路由器正常，故障在其之外：请检查 TCP/DNS（参见 DNS 检查）或联系 ISP。"
          }
        }
      }
    },
    "diag.ping.icmp_jitter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pings ins Internet haben eine schwankende Latenz, aber TCP/HTTP-Verbindungen sind in Ordnung: ICMP wird nachrangig behandelt, das ist kein Ausfall"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pings to the Internet have unstable latency but TCP/HTTP connections are fine: ICMP is deprioritized, this is not an outage"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pings a Internet tienen una latencia inestable pero las conexiones TCP/HTTP van bien: ICMP tiene baja prioridad, no es una caída"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pings vers Internet ont une latence instable mais les connexions TCP/HTTP sont correctes : l'ICMP est traité en basse priorité, ce n'est pas une panne"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットへの ping の遅延は不安定ですが、TCP/HTTP 接続は正常です。ICMP の優先度が低く扱われており、障害ではありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷으로의 ping은 지연이 불안정하지만 TCP/HTTP 연결은 정상입니다: ICMP가 낮은 우선순위로 처리된 것이며 장애가 아닙니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pings para a Internet têm latência instável, mas as conexões TCP/HTTP estão normais: o ICMP tem baixa prioridade, não é uma queda"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ping ra Internet có độ trễ không ổn định nhưng kết nối TCP/HTTP ổn: ICMP bị xếp ưu tiên thấp, không phải mất mạng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到互联网的 ping 延迟不稳定，但 TCP/HTTP 连接正常：ICMP 被降低优先级，并非断网"
          }
        }
      }
    },
    "diag.ping.icmp_limited" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pings ins Internet verlieren Pakete, aber TCP/HTTP-Verbindungen sind in Ordnung: ICMP wird gedrosselt, das ist kein Ausfall"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pings to the Internet lose packets but TCP/HTTP connections are fine: ICMP is rate-limited, this is not an outage"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pings a Internet pierden paquetes pero las conexiones TCP/HTTP van bien: ICMP está limitado en velocidad, no es una caída"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pings vers Internet perdent des paquets mais les connexions TCP/HTTP sont correctes : l'ICMP est limité en débit, ce n'est pas une panne"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットへの ping はパケットを損失していますが、TCP/HTTP 接続は正常です。ICMP がレート制限されており、障害ではありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷으로의 ping은 패킷이 손실되지만 TCP/HTTP 연결은 정상입니다: ICMP가 속도 제한된 것이며 장애가 아닙니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pings para a Internet perdem pacotes, mas as conexões TCP/HTTP estão normais: o ICMP tem limite de taxa, não é uma queda"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ping ra Internet mất gói nhưng kết nối TCP/HTTP ổn: ICMP bị giới hạn, không phải mất mạng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到互联网的 ping 有丢包，但 TCP/HTTP 连接正常：ICMP 被限速，并非断网"
          }
        }
      }
    },
    "diag.ping.jitter" : {
