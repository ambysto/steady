    "diag.ping.advice_icmp_limited" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts zu beheben. Ping ins Internet ist in diesem Netzwerk nicht zuverlässig; die TCP/HTTP-Werte sind maßgeblich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing to fix. Ping to the Internet is not reliable on this network; go by the TCP/HTTP numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada que arreglar. El ping a Internet no es fiable en esta red; guíate por los valores de TCP/HTTP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à corriger. Le ping vers Internet n'est pas fiable sur ce réseau ; fiez-vous aux chiffres TCP/HTTP."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada a corrigir. O ping para a Internet não é confiável nesta rede; baseie-se nos números de TCP/HTTP."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần xử lý. Số đo ping ra Internet không đáng tin trên mạng này; dựa vào số đo TCP/HTTP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需处理。此网络上到互联网的 ping 不可靠，请以 TCP/HTTP 数据为准。"
          }
        }
      }
    },
