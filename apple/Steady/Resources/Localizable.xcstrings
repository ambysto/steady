    "diag.physical_link.weak_signal" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Signal ist sehr schwach, daher liegt es meist an Entfernung oder Hindernissen; siehe Signalprüfung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The signal is very weak, so this is mostly distance or obstacles; see the signal check"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La señal es muy débil, así que se trata sobre todo de distancia u obstáculos; consulta la comprobación de señal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
