    "diag.dns.advice_router_cache" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Router antwortet schnell aus seinem Cache, dieser Wert ist daher zu optimistisch; vor dem Wechsel mit dem schnellsten öffentlichen DNS vergleichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The router answers fast from its cache, so this number is optimistic; compare with the fastest public DNS before switching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El router responde rápido desde su caché, así que este valor es optimista; compáralo con el DNS público más rápido antes de cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le routeur répond vite depuis son cache, ce chiffre est donc optimiste ; comparez avec le DNS public le plus rapide avant de changer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O roteador responde rápido a partir do cache, então este número é otimista; compare com o DNS público mais rápido antes de trocar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Router trả lời nhanh nhờ bộ nhớ đệm nên số đo này lạc quan hơn thực tế; so với DNS công cộng nhanh nhất trước khi đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路由器依靠缓存快速应答，因此该数值偏乐观；切换前请与最快的公共 DNS 对比。"
          }
        }
      }
    },
