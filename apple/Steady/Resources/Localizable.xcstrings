    },
    "apple.diag.signal.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Router und Mac näher zusammenstellen, 5 GHz nutzen, einen Mesh-Knoten hinzufügen oder ein LAN-Kabel anschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the router and the Mac closer, use 5 GHz, add a mesh node, or plug in a LAN cable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca el router y el Mac, usa 5 GHz, añade un nodo mesh o conecta un cable LAN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapprochez le routeur et le Mac, utilisez la bande 5 GHz, ajoutez un nœud mesh ou branchez un câble LAN."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aproxime o roteador e o Mac, use 5 GHz, adicione um nó mesh ou ligue um cabo de rede."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dời router/Mac lại gần, dùng 5GHz, thêm mesh, hoặc cắm LAN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让路由器和 Mac 靠近一些，改用 5 GHz，增加 Mesh 节点，或接上网线。"
          }
        }
      }
    },
