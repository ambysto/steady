    "diag.modem_wifi.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi‑Fi am Modem ausschalten (WLAN-Taste oder Admin-Seite) und den Router mindestens 1 m vom Modem entfernt aufstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off Wi‑Fi on the modem (WLAN button or admin page) and keep the router at least 1 m from the modem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva el Wi‑Fi del módem (botón WLAN o página de administración) y mantén el router al menos a 1 m del módem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez le Wi‑Fi du modem (bouton WLAN ou page d'administration) et gardez le routeur à au moins 1 m du modem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligue o Wi‑Fi do modem (botão WLAN ou página de administração) e mantenha o roteador a pelo menos 1 m do modem."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt Wi‑Fi trên modem (nút WLAN hoặc trang quản trị), đặt router cách modem ≥ 1 m."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请关闭调制解调器上的 Wi‑Fi（WLAN 按钮或管理页面），并让路由器与调制解调器相距至少 1 m。"
          }
        }
      }
    },
    "diag.modem_wifi.advice_loud" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es das alte Modem/der alte Router ist: dessen Wi‑Fi ausschalten und mindestens 1 m vom Haupt-Router entfernt aufstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it is your old modem/router, turn off its Wi‑Fi and keep it at least 1 m from the main router."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si es tu antiguo módem o router, desactiva su Wi‑Fi y mantenlo al menos a 1 m del router principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'il s'agit de votre ancien modem/routeur, désactivez son Wi‑Fi et gardez-le à au moins 1 m du routeur principal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se for seu modem/roteador antigo, desligue o Wi‑Fi dele e mantenha-o a pelo menos 1 m do roteador principal."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu đó là modem/router cũ của bạn, tắt Wi‑Fi của nó và đặt cách router chính ≥ 1 m."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果它是你的旧调制解调器/路由器，请关闭其 Wi‑Fi，并让它与主路由器相距至少 1 m。"
          }
        }
      }
    },
