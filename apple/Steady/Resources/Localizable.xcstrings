    "apple.diag.ping.no_data" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht genug Messungen (benötigt ≥ 60 Messungen in der letzten Stunde)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough measurements yet (needs ≥ 60 samples in the last hour)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay suficientes mediciones (se necesitan ≥ 60 muestras en la última hora)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore assez de mesures (il faut ≥ 60 échantillons sur la dernière heure)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há medições suficientes (são necessárias ≥ 60 amostras na última hora)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa đủ số liệu đo (cần ≥ 60 mẫu trong giờ qua)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测量数据尚不足（最近 1 小时内至少需要 60 个样本）"
          }
        }
      }
    },
    "apple.diag.ping.router_jitter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instabile Latenz zum Router (Jitter über 30 ms): ein lokales Problem (Gerät ↔ Router / Wi‑Fi)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unstable latency to the router (jitter above 30 ms): a local problem (device ↔ router / Wi‑Fi)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latencia inestable hacia el router (jitter por encima de 30 ms): un problema local (dispositivo ↔ router / Wi‑Fi)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latence instable vers le routeur (gigue au-dessus de 30 ms) : problème local (appareil ↔ routeur / Wi‑Fi)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latência instável até o roteador (jitter acima de 30 ms): problema local (dispositivo ↔ roteador / Wi‑Fi)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ trễ tới router không ổn định (jitter trên 30 ms): lỗi nội bộ (thiết bị ↔ router / Wi‑Fi)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到路由器的延迟不稳定（抖动超过 30 ms）：本地问题（设备 ↔ 路由器 / Wi‑Fi）"
          }
        }
      }
    },
