    "ui.failover.admin_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Administratorrechte fragt Windows bei jedem Wechsel nach einer Bestätigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without Administrator rights, Windows asks for approval at each switch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin permisos de administrador, Windows pide aprobación en cada cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans droits d'administrateur, Windows demande une validation à chaque basculement."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem direitos de administrador, o Windows pede aprovação a cada troca."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có quyền Administrator thì mỗi lần chuyển Windows sẽ hỏi xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有管理员权限时，每次切换 Windows 都会请求批准。"
          }
        }
      }
    },
    "ui.failover.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Hauptverbindung das Internet verliert, auf eine andere funktionierende wechseln (Kabel, USB-4G-Modem, Handy-Hotspot)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the main connection loses the Internet, switch to another one that works (cable, USB 4G modem, phone hotspot)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la conexión principal pierde Internet, cambia a otra que funcione (cable, módem USB 4G, punto de acceso del teléfono)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand la connexion principale perd Internet, bascule sur une autre qui fonctionne (câble, modem 4G USB, point d'accès du téléphone)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a conexão principal perde a Internet, troca para outra que funcione (cabo, modem 4G USB, ponto de acesso do celular)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi kết nối chính mất Internet, chuyển sang kết nối khác đang thông (dây mạng, USB 4G, điện thoại phát Wi‑Fi)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主连接断开互联网时，切换到另一条可用的连接（网线、USB 4G 调制解调器、手机热点）。"
          }
        }
      }
    },
    "ui.failover.disconnected" : {
