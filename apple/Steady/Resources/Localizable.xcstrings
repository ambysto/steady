    "diag.interference.advice_24g" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf 5 GHz wechseln, wenn das Signal es zulässt, oder den am wenigsten belegten der Kanäle 1/6/11 wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move to 5 GHz if the signal allows, or switch to whichever of channels 1/6/11 is least crowded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa a 5 GHz si la señal lo permite, o cambia al canal 1, 6 u 11 que esté menos saturado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez en 5 GHz si le signal le permet, ou choisissez celui des canaux 1/6/11 qui est le moins encombré."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mude para 5 GHz se o sinal permitir, ou use o canal menos congestionado entre 1, 6 e 11."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển sang 5GHz nếu tín hiệu cho phép, hoặc đổi sang kênh 1/6/11 ít mạng nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果信号允许，请改用 5 GHz；或在信道 1/6/11 中选择最不拥挤的一个。"
          }
        }
      }
    },
    "diag.interference.advice_5g" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanalgruppe %1$@ ausprobieren (wenigste Netzwerke; Kanal %2$@ ist am leersten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try channel group %1$@ (fewest networks; channel %2$@ is the emptiest)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba el grupo de canales %1$@ (el que tiene menos redes; el canal %2$@ es el más libre)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez le groupe de canaux %1$@ (le moins de réseaux ; le canal %2$@ est le plus libre)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente o grupo de canais %1$@ (menos redes; o canal %2$@ é o mais livre)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thử nhóm kênh %1$@ (ít mạng nhất, kênh %2$@ đang trống nhất)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试信道组 %1$@（网络最少；信道 %2$@ 最空）。"
          }
        }
      }
    },
    "diag.interference.advice_6g" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 GHz hat viele Kanäle: in den Router-Einstellungen einen anderen wählen (oder automatisch wählen lassen) oder eine geringere Kanalbreite nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 GHz has many channels: pick another one in the router's settings (or let it choose automatically), or use a narrower channel width."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La banda de 6 GHz tiene muchos canales: elige otro en los ajustes del router (o deja que lo elija automáticamente) o usa un ancho de canal menor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bande 6 GHz compte de nombreux canaux : choisissez-en un autre dans les réglages du routeur (ou laissez-le choisir automatiquement), ou réduisez la largeur de canal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A faixa de 6 GHz tem muitos canais: escolha outro nas configurações do roteador (ou deixe a escolha automática), ou use uma largura de canal menor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Băng 6 GHz có nhiều kênh: chọn kênh khác trong cấu hình router (hoặc để router tự chọn), hoặc dùng độ rộng kênh hẹp hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 GHz 有很多信道：请在路由器设置中改选其他信道（或设为自动选择），或使用更窄的信道宽度。"
          }
        }
      }
    },
