          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra kết nối tới speed.cloudflare.com (tường lửa/proxy) rồi chạy lại."
          }
        },
        "zh-Hans" : {
