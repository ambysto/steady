    "diag.drops.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Energie-Optimierungen anwenden, den Treiber aktualisieren oder zurücksetzen und den Watchdog aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply the power tweaks, update or roll back the driver, and turn on the watchdog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica las optimizaciones de energía, actualiza o revierte el controlador y activa el watchdog."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez les tweaks d'alimentation, mettez à jour le pilote ou revenez à une version antérieure, et activez le watchdog."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電源関連の調整を適用し、ドライバーを更新またはロールバックして、ウォッチドッグをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원 관련 최적화를 적용하고, 드라이버를 업데이트하거나 롤백하고, 워치독을 켜십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique as otimizações de energia, atualize ou reverta o driver e ative o watchdog."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áp dụng các tweak nguồn điện, cập nhật/rollback driver, bật watchdog."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用电源相关优化项，更新或回退驱动，并开启 Watchdog。"
          }
        }
      }
    },
