        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Gruppe sehr starker unbekannter Netzwerke teilt sich eine MAC-Familie: höchstwahrscheinlich sendet das alte Modem noch Wi‑Fi"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A group of very strong unknown networks shares one MAC family: most likely the old modem still broadcasts Wi‑Fi"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un grupo de redes desconocidas muy fuertes comparte una misma familia MAC: lo más probable es que el módem antiguo siga emitiendo Wi‑Fi"
          }
        },
        "fr" : {
