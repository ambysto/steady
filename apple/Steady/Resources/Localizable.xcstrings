    "diag.bufferbloat.weak_load" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$@-Last erreichte nur %2$@ Mbps, zu wenig, um die Leitung auszulasten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %1$@ load reached only %2$@ Mbps, not enough to fill the line"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga de %1$@ solo alcanzó %2$@ Mbps, insuficiente para llenar la línea"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge (%1$@) n'a atteint que %2$@ Mbps, insuffisant pour saturer la ligne"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carga de %1$@ chegou a apenas %2$@ Mbps, insuficiente para encher a linha"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiều %1$@ chỉ đạt %2$@ Mbps nên không đủ để làm đầy đường truyền"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@负载仅达到 %2$@ Mbps，不足以占满线路"
          }
        }
      }
    },
    "diag.bufferbloat.where_local" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", steigt sogar bis zum Router ⇒ die Warteschlange liegt auf dem Abschnitt PC ↔ Router (überlastetes Wi‑Fi oder überlasteter Router)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", rising even to the router ⇒ the queue is on the PC ↔ router hop (saturated Wi‑Fi or an overloaded router)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", y aumenta incluso hasta el router ⇒ la cola está en el salto PC ↔ router (Wi‑Fi saturado o router sobrecargado)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", y compris vers le routeur ⇒ la file se trouve sur le saut PC ↔ routeur (Wi‑Fi saturé ou routeur surchargé)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", subindo até no roteador ⇒ a fila está no trecho PC ↔ roteador (Wi‑Fi saturado ou roteador sobrecarregado)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", tăng ngay cả tới router ⇒ hàng đợi ở chặng PC ↔ router (Wi‑Fi bão hòa hoặc chính router quá tải)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "，到路由器的延迟也在上升 ⇒ 队列位于电脑 ↔ 路由器这一跳（Wi‑Fi 饱和或路由器过载）"
          }
        }
      }
    },
    "diag.bufferbloat.where_wan" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", steigt nicht bis zum Router ⇒ die Warteschlange liegt auf dem WAN-Abschnitt (Modem/Router → Provider)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", not rising to the router ⇒ the queue is on the WAN hop (modem/router → ISP)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", y no aumenta hasta el router ⇒ la cola está en el salto WAN (módem/router → ISP)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", sans hausse vers le routeur ⇒ la file se trouve sur le saut WAN (modem/routeur → FAI)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", sem subir até o roteador ⇒ a fila está no trecho WAN (modem/roteador → provedor)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", router không tăng ⇒ hàng đợi ở chặng WAN (modem/router → nhà mạng)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "，到路由器的延迟没有上升 ⇒ 队列位于 WAN 这一跳（调制解调器/路由器 → ISP）"
          }
        }
      }
    },
