    "diag.bufferbloat.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SQM / Smart-QoS (fq_codel oder CAKE) am Router aktivieren und die Upload-/Download-Limits etwa 5–10 %% unter der tatsächlichen Bandbreite setzen. Hat der Router kein SQM, die Upload-Geschwindigkeit der Anwendung senken, die die Last verursacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on SQM / smart QoS (fq_codel or CAKE) on the router and set the upload/download limits about 5–10%% below the real bandwidth. If the router has no SQM, lower the upload speed of the app causing the load."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa SQM / QoS inteligente (fq_codel o CAKE) en el router y fija los límites de subida y bajada un 5–10%% por debajo del ancho de banda real. Si el router no tiene SQM, reduce la velocidad de subida de la aplicación que causa la carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez SQM / QoS intelligent (fq_codel ou CAKE) sur le routeur et réglez les limites d'envoi/téléchargement environ 5 à 10%% sous la bande passante réelle. Si le routeur n'a pas de SQM, réduisez le débit d'envoi de l'application qui provoque la charge."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative SQM / QoS inteligente (fq_codel ou CAKE) no roteador e defina os limites de upload/download cerca de 5–10%% abaixo da banda real. Se o roteador não tiver SQM, reduza a velocidade de upload do aplicativo que causa a carga."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật SQM / QoS thông minh (fq_codel hoặc CAKE) trên router và đặt giới hạn tải lên/xuống thấp hơn băng thông thật khoảng 5–10%%. Nếu router không có SQM, giảm tốc độ tải lên của ứng dụng gây tải."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在路由器上开启 SQM / 智能 QoS（fq_codel 或 CAKE），并将上传/下载限速设为比实际带宽低约 5–10%%。如果路由器没有 SQM，请降低造成负载的应用的上传速度。"
          }
        }
      }
    },
    "diag.bufferbloat.advice_incomplete" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ein Lauf, in dem beide Richtungen die Leitung auslasten, kann zeigen, dass alles in Ordnung ist; später erneut ausführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a run in which both directions fill the line can show that it is fine; run it again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo una ejecución en la que ambos sentidos llenen la línea puede mostrar que todo está bien; vuelve a ejecutarla más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule une mesure où les deux sens saturent la ligne peut montrer que tout va bien ; relancez plus tard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só uma execução em que os dois sentidos encham a linha pode mostrar que está tudo bem; execute novamente mais tarde."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ một lần đo mà cả hai chiều đều làm đầy đường truyền mới cho biết mọi thứ ổn; chạy lại sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有两个方向都占满线路的测量才能说明一切正常；请稍后重新运行。"
          }
        }
      }
    },
    "diag.bufferbloat.advice_later" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten, bis der Testserver die Last wieder annimmt, dann erneut ausführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait until the test server accepts the load again, then run again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera a que el servidor de prueba vuelva a aceptar la carga y vuelve a ejecutar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez que le serveur de test accepte à nouveau la charge, puis relancez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde até o servidor de teste aceitar a carga de novo e execute novamente."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chờ máy chủ đo nhận tải trở lại rồi chạy lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请等待测试服务器重新接受负载后再运行。"
          }
        }
      }
    },
    "diag.bufferbloat.advice_retry" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Netzwerkverbindung prüfen und erneut ausführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
