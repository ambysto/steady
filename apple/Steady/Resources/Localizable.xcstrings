    "diag.path_mtu.one_target" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ein Ziel hat geantwortet, und es verwirft womöglich ohnehin Pings, daher ist der kleinere Pfad nicht bestätigt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only one destination answered and it may drop pings anyway, so the smaller path is not confirmed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo respondió un destino y puede descartar pings de todos modos, así que la ruta más pequeña no está confirmada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
