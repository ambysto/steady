          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subida limitada por esta app a %1$@ Mbps y la subida lo alcanzó (%2$@ Mbps): si tu plan es ahora más rápido, desactiva y vuelve a activar el límite para medir la línea"
