    "diag.route.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das deutet meist auf die Route des Internetanbieters zu diesen Zielen hin, nicht auf diesen PC. Am PC lässt sich das nicht beheben: Ein Tunnel-Dienst kann einen kürzeren Weg nehmen (kann aber nahe Seiten bremsen), oder den Anbieter fragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This usually points at the ISP's route to those destinations, not at this PC. Nothing on the PC fixes it: a tunnel service may take a shorter path (but can slow nearby sites), or ask the ISP."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suele apuntar a la ruta del proveedor hacia esos destinos, no a este PC. Nada en el PC lo arregla: un servicio de túnel puede tomar un camino más corto (pero puede ralentizar los sitios cercanos), o consulta al proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela désigne en général la route du fournisseur vers ces destinations, pas ce PC. Rien sur le PC ne le corrige : un service de tunnel peut prendre un chemin plus court (mais peut ralentir les sites proches), ou interrogez le fournisseur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso costuma apontar para a rota do provedor até esses destinos, não para este PC. Nada no PC resolve: um serviço de túnel pode seguir um caminho mais curto (mas pode deixar sites próximos mais lentos), ou fale com o provedor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thường là do tuyến của nhà mạng tới các đích đó, không phải do máy này. Không chỉnh gì trên máy được: một dịch vụ tunnel có thể đi đường ngắn hơn (nhưng có thể làm chậm các trang ở gần), hoặc hỏi nhà mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这通常指向运营商到这些目的地的路由，而不是这台电脑。电脑上无法修复：隧道服务可能走更短的路径（但可能拖慢近处的网站），也可以咨询运营商。"
          }
        }
      }
    },
