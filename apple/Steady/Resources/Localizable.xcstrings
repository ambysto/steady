    "diag.bufferbloat.loss_only" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Median-Latenz steigt kaum an, aber Pings ins Internet verlieren %1$@%% bei ausgelasteter Leitung (eine volle Warteschlange verwirft Pakete)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Median latency barely rises but pings to the Internet lose %1$@%% when the line is busy (a full queue dropping packets)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La latencia mediana apenas aumenta, pero los pings a Internet pierden un %1$@%% cuando la línea está ocupada (una cola llena que descarta paquetes)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La latence médiane augmente à peine mais les pings vers Internet perdent %1$@%% quand la ligne est occupée (une file pleine qui rejette des paquets)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイテンシの中央値はほとんど上がりませんが、回線が混雑するとインターネットへの ping が %1$@%% 失われます（キューが満杯でパケットが破棄されています）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중앙값 지연 시간은 거의 늘지 않지만 회선이 사용 중일 때 인터넷 ping이 %1$@%% 손실됩니다 (큐가 가득 차 패킷을 버리는 상태)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A latência mediana quase não aumenta, mas os pings para a Internet perdem %1$@%% quando a linha está ocupada (uma fila cheia descartando pacotes)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ trễ trung vị gần như không tăng nhưng ping ra Internet mất %1$@%% khi đường truyền bận (hàng đợi đầy làm rớt gói)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "延迟中位数几乎不上升，但线路繁忙时到互联网的 ping 丢包 %1$@%%（队列已满而丢包）"
          }
        }
      }
    },
