    "diag.path_mtu.reported" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Router antworten mit \"Paket zu groß\", daher verkleinert Windows die Pakete selbst; große Pakete gehen nicht verloren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routers answer \"packet too big\", so Windows lowers the packet size by itself; large packets are not lost"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los routers responden \"paquete demasiado grande\", así que Windows reduce el tamaño por sí mismo; los paquetes grandes no se pierden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les routeurs répondent « paquet trop gros », Windows réduit donc lui-même la taille des paquets ; les gros paquets ne sont pas perdus"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os roteadores respondem \"pacote grande demais\", então o Windows reduz o tamanho sozinho; pacotes grandes não se perdem"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Router trả lời \"gói quá lớn\" nên Windows tự giảm kích thước gói; gói lớn không bị mất"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路由器会回复“数据包过大”，Windows 会自行减小数据包；大数据包不会丢失"
          }
        }
      }
    },
    "diag.path_mtu.silent" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große Pakete verschwinden ohne Antwort \"Paket zu groß\": Verbindungen können hängen (PMTUD-Blackhole)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Large packets vanish without any \"packet too big\" answer: connections can hang (PMTUD blackhole)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paquetes grandes desaparecen sin respuesta \"paquete demasiado grande\": las conexiones pueden colgarse (agujero negro de PMTUD)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gros paquets disparaissent sans réponse « paquet trop gros » : les connexions peuvent se bloquer (trou noir PMTUD)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacotes grandes somem sem resposta \"pacote grande demais\": as conexões podem travar (buraco negro de PMTUD)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói lớn biến mất mà không có trả lời \"gói quá lớn\": kết nối có thể treo (PMTUD blackhole)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大数据包在没有“数据包过大”回复的情况下消失：连接可能卡住（PMTUD 黑洞）"
          }
        }
      }
    },
