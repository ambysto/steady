          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói lớn có thể bị rơi dọc đường nên trang treo nửa chừng, tải xuống chập chờn. Đặt MTU của %1$@ thành %2$@ (quyền Admin: netsh interface ipv4 set subinterface \"%1$@\" mtu=%2$@ store=persistent), hoặc bật MSS clamping trên router."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大数据包可能在途中被丢弃，导致网页加载到一半卡住、下载停滞。请将 %1$@ 的 MTU 设为 %2$@（以管理员身份：netsh interface ipv4 set subinterface \"%1$@\" mtu=%2$@ store=persistent），或在路由器上开启 MSS 钳制。"
          }
        }
      }
    },
    "diag.path_mtu.capped" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die MTU der Schnittstelle liegt über %1$@ Byte (Jumbo-Frames); das Internet transportiert höchstens %1$@, daher endet die Messung dort"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The interface MTU is above %1$@ bytes (jumbo frames); the Internet carries at most %1$@, so the probe stops there"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La MTU de la interfaz supera los %1$@ bytes (jumbo frames); Internet transporta como máximo %1$@, así que la prueba se detiene ahí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La MTU de l'interface dépasse %1$@ octets (trames jumbo) ; Internet transporte au plus %1$@, la mesure s'arrête donc là"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MTU da interface passa de %1$@ bytes (jumbo frames); a Internet transporta no máximo %1$@, então o teste para aí"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MTU của card trên %1$@ byte (jumbo frame); Internet chỉ chở tối đa %1$@ nên chỉ dò tới đó"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接口 MTU 超过 %1$@ 字节（巨型帧）；互联网最多传输 %1$@，因此只探测到这里"
          }
        }
      }
    },
