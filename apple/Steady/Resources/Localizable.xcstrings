          }
        }
      }
    },
    "diag.ping.icmp_jitter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pings ins Internet haben eine schwankende Latenz, aber TCP/HTTP-Verbindungen sind in Ordnung: ICMP wird nachrangig behandelt, das ist kein Ausfall"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pings to the Internet have unstable latency but TCP/HTTP connections are fine: ICMP is deprioritized, this is not an outage"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pings a Internet tienen una latencia inestable pero las conexiones TCP/HTTP van bien: ICMP tiene baja prioridad, no es una caída"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pings vers Internet ont une latence instable mais les connexions TCP/HTTP sont correctes : l'ICMP est traité en basse priorité, ce n'est pas une panne"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pings para a Internet têm latência instável, mas as conexões TCP/HTTP estão normais: o ICMP tem baixa prioridade, não é uma queda"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ping ra Internet có độ trễ không ổn định nhưng kết nối TCP/HTTP ổn: ICMP bị xếp ưu tiên thấp, không phải mất mạng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到互联网的 ping 延迟不稳定，但 TCP/HTTP 连接正常：ICMP 被降低优先级，并非断网"
          }
        }
      }
    },
    "diag.ping.icmp_limited" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pings ins Internet verlieren Pakete, aber TCP/HTTP-Verbindungen sind in Ordnung: ICMP wird gedrosselt, das ist kein Ausfall"
          }
        },
        "en" : {
          "stringUnit" : {
