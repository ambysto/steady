{
  "rule": "interference",
  "check": 3,
  "reference": "app/diagnostics.py evaluate_interference",
  "description": "Channel interference (docs/DIAGNOSTICS.md #3). 'wifi' is the connection (state, bssid, channel) or null; 'scan' lists the networks around, one entry per BSSID: ssid ('' when hidden), bssid, signal (percent, null when unknown), band, channel. A network is foreign when its first 5 BSSID octets differ from the connection's and its signal is >= 10%; foreign networks on the connection's channel and band count once per SSID (per BSSID when hidden). >= 2 warn.",
  "cases": [
    {
      "name": "not connected to Wi-Fi",
      "input": {
        "wifi": null,
        "scan": []
      },
      "expected": {
        "status": "info",
        "summary": {
          "key": "diag.interference.not_connected",
          "params": {}
        },
        "details": [],
        "advice": ""
      }
    },
    {
      "name": "Wi-Fi disconnected",
      "input": {
        "wifi": {
          "state": "disconnected",
          "bssid": "02:5e:00:9a:40:24",
          "channel": 40
        },
        "scan": [
          {
            "ssid": "HomeNet",
            "bssid": "02:5e:00:9a:40:24",
            "signal": 50,
            "band": "5 GHz",
            "channel": 40
          }
        ]
      },
      "expected": {
        "status": "info",
        "summary": {
          "key": "diag.interference.not_connected",
          "params": {}
        },
        "details": [],
        "advice": ""
      }
    },
    {
      "name": "connected but the channel is unknown",
      "input": {
        "wifi": {
          "state": "connected",
          "bssid": "02:5e:00:9a:40:24",
          "channel": null
        },
        "scan": [
          {
            "ssid": "HomeNet",
            "bssid": "02:5e:00:9a:40:24",
            "signal": 50,
            "band": "5 GHz",
            "channel": 40
          }
        ]
      },
      "expected": {
        "status": "info",
        "summary": {
          "key": "diag.interference.not_connected",
          "params": {}
        },
        "details": [],
        "advice": ""
      }
    },
    {
      "name": "two foreign networks on the same 5 GHz channel warn, with the quieter group",
      "input": {
        "wifi": {
          "state": "connected",
          "bssid": "02:5e:00:9a:40:24",
          "channel": 40
        },
        "scan": [
          {
            "ssid": "HomeNet",
            "bssid": "02:5e:00:9a:40:24",
            "signal": 50,
            "band": "5 GHz",
            "channel": 40
          },
          {
            "ssid": "A",
            "bssid": "aa:00:00:00:00:01",
            "signal": 50,
            "band": "5 GHz",
            "channel": 40
          },
          {
            "ssid": "B",
            "bssid": "bb:00:00:00:00:02",
            "signal": 50,
            "band": "5 GHz",
            "channel": 40
          }
        ]
      },
      "expected": {
        "status": "warn",
        "summary": {
          "key": "diag.interference.crowded",
          "params": {
            "count": 2,
            "channel": 40
          }
        },
        "details": [
          {
            "key": "diag.interference.current",
            "params": {
              "channel": 40,
              "band": "5 GHz",
              "count": 2
            }
          },
          {
            "key": "diag.common.network_signal",
            "params": {
              "ssid": "A",
              "signal": 50
            }
          },
          {
            "key": "diag.common.network_signal",
            "params": {
              "ssid": "B",
              "signal": 50
            }
          },
          {
            "key": "diag.interference.groups",
            "params": {
              "groups": [
                "36–48: 2",
                "149–161: 0"
              ]
            }
          }
        ],
        "advice": {
          "key": "diag.interference.advice_5g",
          "params": {
            "group": "149–161",
            "channel": 149
          }
        }
      }
    },
    {
      "name": "one foreign network is quiet",
      "input": {
        "wifi": {
          "state": "connected",
          "bssid": "02:5e:00:9a:40:24",
          "channel": 40
        },
        "scan": [
          {
            "ssid": "HomeNet",
            "bssid": "02:5e:00:9a:40:24",
            "signal": 50,
            "band": "5 GHz",
            "channel": 40
