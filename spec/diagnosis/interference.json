          {
            "key": "diag.interference.current",
            "params": {
              "channel": 40,
              "band": "5 GHz",
              "count": 1
            }
          },
          {
            "key": "diag.common.network_signal",
            "params": {
              "ssid": "A",
              "signal": 50
            }
          }
        ],
        "advice": ""
      }
    },
