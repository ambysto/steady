{
  "rule": "link",
  "check": 13,
  "reference": "app/diagnostics.py evaluate_link",
  "description": "Poor physical link (docs/DIAGNOSTICS.md #13) over the connected minutes of the last 24 hours. 'runs' expand to minutes: 'count' consecutive minutes starting at 'from' (seconds since 1970), 60 s apart, each with rssi (dBm), rx_mbps (the link rate; the Mac gives its Tx rate) and router_loss_pct. 'now' (or null) enables the last-3-hours comparison. A minute is bad when the rate is <= 30 Mbps and router loss >= 5%; >= 30 minutes needed; >= 5% bad info, >= 20% warn.",
  "cases": [
    {
      "name": "not enough data: 29 minutes",
      "input": {
        "runs": [
          {
            "from": 1789928040,
            "count": 29,
            "rssi": -65,
            "rx_mbps": 500,
            "router_loss_pct": 0.0
          }
        ],
        "now": null
      },
      "expected": {
        "status": "info",
        "summary": {
          "key": "diag.physical_link.not_enough",
          "params": {
            "count": 29,
            "needed": 30
          }
        },
        "details": [],
        "advice": ""
      }
    },
