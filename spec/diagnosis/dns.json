{
  "rule": "dns",
  "check": 6,
  "reference": "app/diagnostics.py evaluate_dns",
  "description": "DNS benchmark (docs/DIAGNOSTICS.md #6). bench: one entry per server in the order measured (servers in use first, then the router, then public resolvers), each with sent, replies, failures and the round-trip times (ms) of the answers that count. in_use: the system's DNS servers, primary first. labels: server -> in_use | in_use_router | router | public.",
  "cases": [
    {
      "name": "no server measured",
      "input": {
        "bench": [],
        "in_use": [],
        "labels": {}
      },
      "expected": {
        "status": "info",
        "summary": {
          "key": "diag.dns.no_servers",
          "params": {}
        },
        "details": [],
        "advice": ""
      }
    },
    {
      "name": "the DNS in use was not measured",
      "input": {
        "bench": [
          {
            "server": "9.9.9.9",
            "sent": 5,
            "replies": 5,
            "failures": 0,
            "rtts_ms": [
              30,
              30,
              30,
              30,
              30
            ]
          }
        ],
        "in_use": [
          "203.0.113.53"
        ],
        "labels": {
          "1.1.1.1": "public",
          "8.8.8.8": "public",
          "9.9.9.9": "public"
        }
      },
      "expected": {
        "status": "info",
        "summary": {
          "key": "diag.dns.unknown_in_use",
          "params": {}
        },
        "details": [
          {
            "key": "diag.dns.line",
            "params": {
              "label": {
                "key": "diag.dns.role.public",
                "params": {}
