{
  "cleanUrls": true,
  "redirects": [
    { "source": "/terms", "destination": "https://ambysto.com/terms", "permanent": false },
    { "source": "/refund-policy", "destination": "https://ambysto.com/refund-policy", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
